# AI Chat - API Key (required)
# Get this from your ByNara router account
VITE_AI_API_KEY=sk-your-api-key-here

# AI Chat - Model name (default: auto/bynara)
VITE_AI_MODEL=glm-5.2-free

# AI Chat - API proxy path (Vite proxies this to router.bynara.id)
VITE_AI_API_BASE=/api/ai

# Backend ML API URL (local FastAPI server)
# Must be running: python backend/app.py
VITE_API_URL=http://localhost:8000
