\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Global mean relative feature attribution computed via Integrated Gradients ($M=30$ steps, zero baseline) averaged over all 450 test plots. Green bars denote positive yield influence; red bars denote negative. Stalk volume ($V_{\text  {stalk}}$, +28.4\%), nitrogen rate (+14.2\%), and root-zone moisture (+11.8\%) are the dominant drivers. Disease severity ($-15.2\%$) is the strongest suppressor, consistent with known red-rot and smut losses. Attribution totals 100\%.}}{11}{figure.7}\protected@file@percent }
\newlabel{fig:attribution}{{7}{11}{Global mean relative feature attribution computed via Integrated Gradients ($M=30$ steps, zero baseline) averaged over all 450 test plots. Green bars denote positive yield influence; red bars denote negative. Stalk volume ($V_{\text {stalk}}$, +28.4\%), nitrogen rate (+14.2\%), and root-zone moisture (+11.8\%) are the dominant drivers. Disease severity ($-15.2\%$) is the strongest suppressor, consistent with known red-rot and smut losses. Attribution totals 100\%}{figure.7}{}}
